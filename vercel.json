{
  "redirects": [
    {
      "source": "/reservation-cif.html",
      "destination": "/reservation-conference.html",
      "permanent": false
    },
    {
      "source": "/reservation-cif.html/:slug",
      "destination": "/reservation-conference.html/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/reservation.html/:slug",
      "destination": "/reservation.html?code=:slug"
    },
    {
      "source": "/reservation-entreprise.html/:slug",
      "destination": "/reservation-entreprise.html?code=:slug"
    },
    {
      "source": "/reservation-cif.html/:slug",
      "destination": "/reservation-conference.html?code=:slug"
    },
    {
      "source": "/reservation-conference.html/:slug",
      "destination": "/reservation-conference.html?code=:slug"
    },
    {
      "source": "/confirm-reservation.html/:slug",
      "destination": "/confirm-reservation.html?code=:slug"
    },
    {
      "source": "/temporary-reservation.html/:slug",
      "destination": "/temporary-reservation.html?code=:slug"
    },
    {
      "source": "/post-booking-entreprise.html/:slug",
      "destination": "/post-booking-entreprise.html?code=:slug"
    },
    {
      "source": "/modalites-hercule.html/:slug",
      "destination": "/modalites-hercule.html"
    }
  ]
}

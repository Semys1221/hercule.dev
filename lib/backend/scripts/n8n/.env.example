# Copy to .env (never commit .env). Generate secrets via install-local.sh or install-n8n.sh.
# Use hex for N8N_ENCRYPTION_KEY to avoid docker-compose $ expansion issues in .env files.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n

# openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-64-hex-chars

N8N_VERSION=1.82.1
N8N_BIND=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL for production webhooks (VPS phase 2): https://n8n.example.com/
WEBHOOK_URL=http://localhost:5678/

TZ=Europe/Paris
N8N_DIAGNOSTICS_ENABLED=false

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-basic-auth
